# ------------------------------
# Backend Configuration
# ------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# When using Docker Compose, MONGODB_URI is overridden in docker-compose.yml 
# to use the internal Docker network hostname 'mongodb'
MONGODB_URI=mongodb://localhost:27017/stuhub

JWT_SECRET=development-secret-change-me-should-be-at-least-16-characters-long
JWT_EXPIRES_IN=7d

# Cloudinary (Optional, for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Integration API Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Google Auth (Optional, for Google Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id

# GitHub Auth (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# LinkedIn Auth (Optional)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ------------------------------
# Frontend Configuration (Vite)
# ------------------------------
# In a Docker Compose environment, the frontend runs in the user's browser, 
# so it still needs to access the backend via localhost on port 5000.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id